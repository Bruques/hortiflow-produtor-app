generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelSocio {
  FINANCIADOR
  MEEIRO
  MISTO
}

enum StatusSafra {
  PLANEJADA
  EM_ANDAMENTO
  ENCERRADA
}

enum TipoDespesa {
  TERRA
  MUDAS
  ADUBO
  DEFENSIVOS
  MAO_DE_OBRA
  EMBALAGEM
  TRANSPORTE
  OUTRO
}

enum TipoAcerto {
  PARCIAL
  FINAL
}

enum TipoGatilhoRegra {
  POR_VENDA
  POR_PERIODO
}

enum StatusUsuario {
  ATIVO
  BLOQUEADO
  // Spec 20 — anonimização de conta: usado só quando o usuário ainda tem despesas/vendas
  // como sócio não-titular em sociedade de outra pessoa, e por isso a linha `Usuario` não
  // pode ser excluída fisicamente (ver docs/specs/20-exclusao-de-conta.md).
  EXCLUIDO
}

// Spec 19 — despesa pendente de pagamento e parcelamento
enum StatusPagamento {
  PAGO
  PENDENTE
}

// Spec 18 — assinatura e pagamento
enum StatusAssinatura {
  TRIAL
  ATIVA
  CANCELADA
}

enum MetodoPagamento {
  GATEWAY_ASAAS
  MANUAL_PIX
  MANUAL_DINHEIRO
}

model Usuario {
  id         String        @id @default(uuid())
  nome       String
  telefone   String        @unique
  senha_hash String
  status     StatusUsuario @default(ATIVO)
  criado_em  DateTime      @default(now())

  socioSociedades   SocioSociedade[]
  despesas          Despesa[]
  despesasPessoais  DespesaPessoal[]
  aportesTrabalho   AporteTrabalho[]
  regrasComoSocio   RegraDespesaRecorrente[] @relation("RegraSocio")
  regrasCriadas     RegraDespesaRecorrente[] @relation("RegraCriador")
  eventosAuditoria  EventoAuditoria[]
  sociedadesCriadas Sociedade[]              @relation("SociedadeTitular")
  assinatura        Assinatura?

  @@map("usuarios")
}

// Spec 18 — login do painel administrativo, totalmente separado do login de produtor
// (Usuario): sem cadastro público, sem trial, sem tela de auto-registro. A única conta
// é criada manualmente no banco pelo desenvolvedor (Prisma Studio ou script), o mesmo
// padrão de "acesso administrativo ligado à mão" já usado na spec 16.
model AdminUsuario {
  id         String   @id @default(uuid())
  nome       String
  email      String   @unique
  senha_hash String
  criado_em  DateTime @default(now())

  pagamentosRegistrados Pagamento[]

  @@map("admin_usuarios")
}

// Spec 18 — 1:1 com o Usuario que criou a(s) Sociedade(s) (o "titular"). Todo
// usuário ganha uma no registro, com trial de 14 dias; o plano só é atribuído
// manualmente pelo admin depois (ver docs/specs/18-assinatura-e-pagamento.md).
model Assinatura {
  id                            String           @id @default(uuid())
  // Spec 20 — nullable pra permitir excluir fisicamente um `Usuario` titular mantendo o
  // histórico de `Pagamento` (registro financeiro do desenvolvedor, não dado pessoal do
  // usuário) em vez de apagá-lo junto.
  usuario_id                    String?          @unique
  plano_id                      String?
  status                        StatusAssinatura @default(TRIAL)
  data_inicio                   DateTime         @default(now())
  data_fim_acesso               DateTime
  // Override pontual do limite de safras ativas do plano, só para este titular
  // (negociação fora da régua padrão dos 3 planos) — null = usa o limite do plano.
  limite_safras_ativas_override Int?
  asaas_customer_id             String?
  asaas_subscription_id         String?
  criado_em                     DateTime         @default(now())
  atualizado_em                 DateTime         @updatedAt

  usuario    Usuario?    @relation(fields: [usuario_id], references: [id])
  plano      Plano?      @relation(fields: [plano_id], references: [id])
  pagamentos Pagamento[]

  @@map("assinaturas")
}

// Spec 18 — catálogo de planos (fixo em 3, mas valor/limite editáveis pelo admin
// sem precisar de deploy).
model Plano {
  id                   String   @id @default(uuid())
  nome                 String
  valor_mensal         Decimal  @db.Decimal(10, 2)
  limite_safras_ativas Int?
  criado_em            DateTime @default(now())
  atualizado_em        DateTime @updatedAt

  assinaturas Assinatura[]

  @@map("planos")
}

// Spec 18 — histórico de cada cobrança confirmada (gateway ou manual), usado
// pelo painel admin pra ver "o que já foi pago, por qual meio".
model Pagamento {
  id                      String          @id @default(uuid())
  assinatura_id           String
  metodo                  MetodoPagamento
  valor                   Decimal         @db.Decimal(10, 2)
  periodo_inicio          DateTime
  periodo_fim             DateTime
  asaas_payment_id        String?
  registrado_por_admin_id String?
  criado_em               DateTime        @default(now())

  assinatura    Assinatura    @relation(fields: [assinatura_id], references: [id])
  registradoPor AdminUsuario? @relation(fields: [registrado_por_admin_id], references: [id])

  @@map("pagamentos")
}

// Spec 17 — trilha de eventos de conta (cadastro, login, logout, bloqueio/desbloqueio),
// separada dos modelos de negócio porque alimenta o futuro dashboard de observabilidade,
// não nenhum cálculo de divisão/sociedade.
model EventoAuditoria {
  id         String   @id @default(uuid())
  usuario_id String?
  tipo       String
  metadata   Json?
  criado_em  DateTime @default(now())

  usuario Usuario? @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@index([tipo])
  @@map("eventos_auditoria")
}

model Sociedade {
  id                    String   @id @default(uuid())
  nome                  String
  codigo_convite        String   @unique
  // Spec 18 — o titular cuja Assinatura/plano governam o acesso de todos que
  // participam desta Sociedade (financiador ou meeiro). Gravado na criação,
  // imutável depois.
  criado_por_usuario_id String
  criado_em             DateTime @default(now())

  criadoPor         Usuario                  @relation("SociedadeTitular", fields: [criado_por_usuario_id], references: [id])
  socios            SocioSociedade[]
  safras            Safra[]
  regrasRecorrentes RegraDespesaRecorrente[]
  unidadesVenda     UnidadeVenda[]

  @@map("sociedades")
}

model SocioSociedade {
  id               String     @id @default(uuid())
  usuario_id       String?
  nome             String?
  sociedade_id     String
  percentual_lucro Decimal    @db.Decimal(5, 2)
  papel            PapelSocio
  criado_em        DateTime   @default(now())

  usuario        Usuario?        @relation(fields: [usuario_id], references: [id])
  sociedade      Sociedade       @relation(fields: [sociedade_id], references: [id])
  acertoSocios   AcertoSocio[]
  rateiosDespesa RateioDespesa[]
  rateiosRegra   RateioRegra[]

  @@unique([usuario_id, sociedade_id])
  @@map("socio_sociedades")
}

model Safra {
  id           String      @id @default(uuid())
  sociedade_id String
  nome         String
  observacoes  String?
  status       StatusSafra @default(PLANEJADA)
  data_inicio  DateTime?
  data_fim     DateTime?
  criado_em    DateTime    @default(now())

  sociedade        Sociedade        @relation(fields: [sociedade_id], references: [id])
  despesas         Despesa[]
  despesasPessoais DespesaPessoal[]
  vendas           Venda[]
  acertos          Acerto[]
  aportesTrabalho  AporteTrabalho[]

  @@map("safras")
}

model Despesa {
  id               String          @id @default(uuid())
  safra_id         String
  socio_id         String
  tipo             TipoDespesa
  valor            Decimal         @db.Decimal(10, 2)
  data             DateTime
  foto_comprovante String?
  descricao        String?
  regra_origem_id  String?
  venda_origem_id  String?
  // Spec 19 — despesa pendente de pagamento e parcelamento. `data_vencimento` só é
  // obrigatória quando status_pagamento = PENDENTE; `data_pagamento` é preenchida
  // automaticamente (= `data`) quando já criada como PAGO, ou ao marcar como paga depois.
  // Nenhum dos dois entra em calcularDivisao — são só informativos.
  status_pagamento StatusPagamento @default(PAGO)
  data_vencimento  DateTime?
  data_pagamento   DateTime?
  // Chave de idempotência opcional enviada pelo cliente (o `localId` gerado pela fila de sync
  // offline do mobile) — permite que um retry de POST após timeout de rede reconheça que a
  // despesa já foi criada em vez de duplicar (ver docs/specs/mobile/00-setup-e-infra.md).
  idempotency_key  String?         @unique
  criado_em        DateTime        @default(now())

  safra       Safra                   @relation(fields: [safra_id], references: [id])
  socio       Usuario                 @relation(fields: [socio_id], references: [id])
  regraOrigem RegraDespesaRecorrente? @relation(fields: [regra_origem_id], references: [id])
  vendaOrigem Venda?                  @relation(fields: [venda_origem_id], references: [id])
  rateios     RateioDespesa[]

  @@map("despesas")
}

// Rateio próprio de uma Despesa entre sócios, independente do percentual_lucro da
// sociedade (docs/specs/13-rateio-de-despesas.md). Ausência de linhas pra uma Despesa
// significa "rateio padrão" (segue o percentual_lucro vigente no momento do cálculo).
model RateioDespesa {
  id                 String  @id @default(uuid())
  despesa_id         String
  socio_sociedade_id String
  percentual         Decimal @db.Decimal(5, 2)

  despesa        Despesa        @relation(fields: [despesa_id], references: [id])
  socioSociedade SocioSociedade @relation(fields: [socio_sociedade_id], references: [id])

  @@unique([despesa_id, socio_sociedade_id])
  @@map("rateios_despesa")
}

// Mesmo conceito de RateioDespesa, mas como "receita" de uma RegraDespesaRecorrente —
// copiado (congelado) em RateioDespesa a cada Despesa gerada pela regra, pra não recalcular
// despesas antigas se o rateio da regra mudar depois.
model RateioRegra {
  id                 String  @id @default(uuid())
  regra_id           String
  socio_sociedade_id String
  percentual         Decimal @db.Decimal(5, 2)

  regra          RegraDespesaRecorrente @relation(fields: [regra_id], references: [id])
  socioSociedade SocioSociedade         @relation(fields: [socio_sociedade_id], references: [id])

  @@unique([regra_id, socio_sociedade_id])
  @@map("rateios_regra")
}

model DespesaPessoal {
  id         String      @id @default(uuid())
  safra_id   String
  usuario_id String
  tipo       TipoDespesa
  valor      Decimal     @db.Decimal(10, 2)
  data       DateTime
  descricao  String?
  criado_em  DateTime    @default(now())

  safra   Safra   @relation(fields: [safra_id], references: [id])
  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@map("despesas_pessoais")
}

model AporteTrabalho {
  id        String   @id @default(uuid())
  safra_id  String
  socio_id  String
  data      DateTime
  horas     Decimal  @db.Decimal(5, 2)
  descricao String?
  criado_em DateTime @default(now())

  safra Safra   @relation(fields: [safra_id], references: [id])
  socio Usuario @relation(fields: [socio_id], references: [id])

  @@map("aportes_trabalho")
}

model Venda {
  id              String   @id @default(uuid())
  safra_id        String
  unidade_id      String
  data            DateTime
  quantidade      Decimal  @db.Decimal(10, 2)
  preco           Decimal  @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(10, 2)
  comprador       String?
  pago            Boolean  @default(false)
  // Mesma chave de idempotência de Despesa — ver comentário lá.
  idempotency_key String?  @unique
  criado_em       DateTime @default(now())

  safra           Safra        @relation(fields: [safra_id], references: [id])
  unidade         UnidadeVenda @relation(fields: [unidade_id], references: [id])
  despesasGeradas Despesa[]

  @@map("vendas")
}

model UnidadeVenda {
  id           String   @id @default(uuid())
  sociedade_id String
  nome         String
  ativo        Boolean  @default(true)
  criado_em    DateTime @default(now())

  sociedade Sociedade                @relation(fields: [sociedade_id], references: [id])
  vendas    Venda[]
  regras    RegraDespesaRecorrente[]

  @@unique([sociedade_id, nome])
  @@map("unidades_venda")
}

model RegraDespesaRecorrente {
  id           String           @id @default(uuid())
  sociedade_id String
  socio_id     String
  criado_por   String
  tipo_gatilho TipoGatilhoRegra
  tipo_despesa TipoDespesa
  valor        Decimal          @db.Decimal(10, 2)
  unidade_id   String?
  ativo        Boolean          @default(true)
  criado_em    DateTime         @default(now())

  sociedade Sociedade     @relation(fields: [sociedade_id], references: [id])
  socio     Usuario       @relation("RegraSocio", fields: [socio_id], references: [id])
  criador   Usuario       @relation("RegraCriador", fields: [criado_por], references: [id])
  unidade   UnidadeVenda? @relation(fields: [unidade_id], references: [id])
  despesas  Despesa[]
  rateios   RateioRegra[]

  @@map("regras_despesa_recorrente")
}

model Acerto {
  id          String     @id @default(uuid())
  safra_id    String
  data_inicio DateTime
  data_fim    DateTime
  tipo        TipoAcerto
  criado_em   DateTime   @default(now())

  safra  Safra         @relation(fields: [safra_id], references: [id])
  socios AcertoSocio[]

  @@map("acertos")
}

model AcertoSocio {
  id                  String  @id @default(uuid())
  acerto_id           String
  socio_id            String
  despesas_bancadas   Decimal @db.Decimal(10, 2)
  percentual_aplicado Decimal @db.Decimal(5, 2)
  valor_lucro         Decimal @db.Decimal(10, 2)

  acerto Acerto         @relation(fields: [acerto_id], references: [id])
  socio  SocioSociedade @relation(fields: [socio_id], references: [id])

  @@map("acerto_socios")
}
