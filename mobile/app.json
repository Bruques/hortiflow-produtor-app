{
  "expo": {
    "name": "HortiFlow Produtor",
    "slug": "hortiflow-produtor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hortiflow.produtor",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "5"
    },
    "android": {
      "package": "com.hortiflow.produtor",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O HortiFlow usa a câmera para anexar a foto do comprovante a uma despesa."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "38ae535e-c8c4-4833-bb96-5a0fc94aa8d3"
      }
    },
    "owner": "dev.brunomarques"
  }
}
