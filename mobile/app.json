{
  "expo": {
    "name": "HortiFlow Produtor",
    "slug": "hortiflow-produtor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hortiflow.produtor",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "9"
    },
    "android": {
      "package": "com.hortiflow.produtor",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 12
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sqlite",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O HortiFlow usa a câmera para anexar a foto do comprovante a uma despesa.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#faf9f4"
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "38ae535e-c8c4-4833-bb96-5a0fc94aa8d3"
      }
    },
    "owner": "dev.brunomarques"
  }
}
