# URL da API do backend. Expo exige o prefixo EXPO_PUBLIC_ para expor a variável ao bundle JS
# (equivalente ao VITE_ usado no frontend web, mas com convenção própria do Expo).
EXPO_PUBLIC_API_URL=https://SUBSTITUIR-pela-URL-do-backend-develop-no-Railway/api

# DSN do projeto no Sentry (spec 17) — sem essa variável, o app roda normalmente só sem
# captura de erro (ver src/lib/sentry.ts). Criar o projeto em sentry.io e colar o DSN aqui.
EXPO_PUBLIC_SENTRY_DSN=

# Spec 25 — URL do frontend web, usada só pra abrir a página de tokenização de cartão
# (cartão mensal recorrente) numa WebView (ver CheckoutScreen.tsx).
EXPO_PUBLIC_WEB_BASE_URL=https://SUBSTITUIR-pela-URL-do-frontend-develop-na-Vercel
